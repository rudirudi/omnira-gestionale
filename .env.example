# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
# Chiave pubblica: "publishable" (sb_publishable_...) oppure la vecchia "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Assistente virtuale (chat): chiave API di Anthropic, da creare su platform.claude.com
# Su Vercel: Settings → Environment Variables. Non va mai nel codice.
ANTHROPIC_API_KEY=
# Facoltativo: modello da usare (predefinito claude-sonnet-5-5)
# ASSISTANT_MODEL=claude-sonnet-5-5
